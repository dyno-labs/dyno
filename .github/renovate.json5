// Renovate opens the dependency update pull requests for this repo. It runs from
// .github/workflows/renovate.yml as the dyno-bot GitHub App, on our own runner. The options only
// a self-hosted Renovate can set are in .github/renovate/global.json5.
//
// How it works:
// - New updates come on Mondays (UTC), in a few groups, with at most 10 PRs open at once.
//   Security fixes come at any time.
// - A release must be 3 days old before Renovate offers it, so a bad or malicious release has
//   time to be pulled. Security fixes do not wait. The weekly refresh of Cargo.lock cannot wait:
//   cargo picks those versions, and it has no such option (npm does, and uses it).
// - Patch, minor, digest and pin updates, and the weekly lock file refresh, merge on their own
//   once the required checks pass (by rebase, as the main ruleset asks). Majors, minors of 0.x
//   packages (before 1.0 a minor may break), the oxc crates and cargo-dist wait for a person.
// - An update that merges on its own and changes an engine package (crates/, packages/schema/)
//   has the label "no change file": it changes no behaviour, or the tests would fail. A person who
//   merges one of the others adds a change file or that label (docs/releasing.md).
// - Nothing in fixtures/ changes: those versions are inputs to byte-exact builds.
// - Commits are "chore(deps): ..." with a DCO Signed-off-by line (CONTRIBUTING.md).
// - package-lock.json moves with package.json.
// - A Cargo change regenerates THIRD_PARTY_NOTICES.md in the same commit. Nothing else is
//   regenerated: an update that changes the JSON Schema, the TypeScript types, a snapshot or the
//   golden hashes fails the tests, and a person updates them.
//
// Check a change with Node 24, which Renovate 44 needs (mise.toml has a newer Node):
// npx --yes --package renovate -- renovate-config-validator --strict
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":gitSignOff",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests",
  ],
  semanticCommits: "enabled",
  semanticCommitScope: "deps",
  labels: ["dependencies"],
  // release.yml is generated by cargo-dist (see the cargo-dist rule below).
  ignorePaths: ["**/node_modules/**", "fixtures/**", ".github/workflows/release.yml"],

  schedule: ["* * * * 1"],
  prConcurrentLimit: 10,
  prHourlyLimit: 4,
  minimumReleaseAge: "3 days",
  // No PR until a release is old enough. The dependency dashboard lists the ones that wait.
  internalChecksFilter: "strict",
  // Keep Cargo.toml and package.json at the versions in the lock files.
  rangeStrategy: "bump",
  automergeStrategy: "rebase",
  lockFileMaintenance: { enabled: true, schedule: ["* * * * 1"] },
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: { addLabels: ["security"] },
  // The Rust that Renovate's container uses for Cargo.lock and the notices: the CI toolchain.
  constraints: { rust: "1.99.1" },

  customManagers: [
    {
      description: "cargo-about's release binary, for the notices task",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/renovate/third-party-notices\\.sh$/"],
      matchStrings: ["version=(?<currentValue>\\S+)\\nsha256=(?<currentDigest>[0-9a-f]{64})"],
      depNameTemplate: "github:EmbarkStudios/cargo-about",
      packageNameTemplate: "EmbarkStudios/cargo-about",
      datasourceTemplate: "github-release-attachments",
    },
    {
      description: "cargo-dist, which generates release.yml",
      customType: "regex",
      managerFilePatterns: ["/^dist-workspace\\.toml$/", "/^docs/releasing\\.md$/"],
      matchStrings: [
        'cargo-dist-version = "(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
        "cargo-dist (?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      depNameTemplate: "cargo-dist",
      packageNameTemplate: "axodotdev/cargo-dist",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      description: "cargo-deny, where docs/releasing.md names it",
      customType: "regex",
      managerFilePatterns: ["/^docs/releasing\\.md$/"],
      matchStrings: ["cargo-deny (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "cargo-deny",
      packageNameTemplate: "EmbarkStudios/cargo-deny",
      datasourceTemplate: "github-releases",
    },
    {
      description: "cargo-about, where docs/releasing.md names it",
      customType: "regex",
      managerFilePatterns: ["/^docs/releasing\\.md$/"],
      matchStrings: ["cargo-about (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "github:EmbarkStudios/cargo-about",
      packageNameTemplate: "EmbarkStudios/cargo-about",
      datasourceTemplate: "github-releases",
    },
    {
      description: "The CI Rust toolchain, where the docs name it",
      customType: "regex",
      managerFilePatterns: ["/^README\\.md$/", "/^CONTRIBUTING\\.md$/"],
      matchStrings: ["CI uses (?<currentValue>\\d+\\.\\d+\\.\\d+)\\."],
      depNameTemplate: "rust",
      datasourceTemplate: "rust-version",
    },
    {
      description: "Packages that scripts and workflows run with npx at a set version",
      customType: "regex",
      managerFilePatterns: ["/\\.sh$/", "/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "npx (?:-y |--yes )?(?<depName>(?:@[\\w.-]+/)?[\\w.-]+)@(?<currentValue>\\d[\\w.-]*)",
      ],
      datasourceTemplate: "npm",
    },
  ],

  packageRules: [
    // Where versions come from.
    {
      description: "cargo-dist's release tags start with v, which mise.toml leaves out",
      matchManagers: ["mise"],
      matchDepNames: ["cargo-dist"],
      extractVersion: "^v(?<version>.+)$",
    },

    // The release age.
    {
      description: "A pin keeps the version, so it has no release to wait for",
      matchUpdateTypes: ["pin", "pinDigest"],
      minimumReleaseAge: null,
    },
    {
      description: "cargo picks the versions of a Cargo.lock refresh and cannot wait for their age",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },

    // Groups, from the widest to the narrowest: a later rule wins.
    {
      groupName: "Rust crates",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      groupName: "npm packages",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      groupName: "GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
    },
    {
      groupName: "tools",
      matchManagers: ["mise"],
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: "mise itself: the action, and the mise version that every workflow gives it",
      groupName: "mise",
      matchDepNames: ["jdx/mise-action", "jdx/mise"],
    },
    {
      groupName: "cargo-deny and cargo-about",
      matchDepNames: ["cargo-deny", "github:EmbarkStudios/cargo-about"],
    },
    {
      description: "The CI toolchain: mise.toml, the docs and constraints.rust",
      groupName: "Rust toolchain",
      matchDepNames: ["rust"],
    },

    // What merges on its own.
    {
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      automerge: true,
    },
    {
      description: "The change-file check: an engine package's update that merges on its own changes no behaviour",
      matchFileNames: ["crates/**", "packages/schema/**"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      labels: ["dependencies", "no change file"],
    },
    {
      description: "Before 1.0 a minor may break, so it leaves its group and waits for a person",
      matchCurrentVersion: "/^v?0\\./",
      matchUpdateTypes: ["minor"],
      groupName: null,
      automerge: false,
      labels: ["dependencies", "breaking"],
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["dependencies", "breaking"],
    },

    // Exceptions.
    {
      description: "oxc changes its API between minors: its crates are pinned exactly and move together",
      matchManagers: ["cargo"],
      matchPackageNames: ["oxc_*"],
      groupName: "oxc",
      automerge: false,
      prBodyNotes: [
        "oxc changes its API between minor versions. Fix the static scan in `crates/dyno-static` if it no longer builds, and read the oxc changelog for changes in what the parser accepts.",
      ],
    },
    {
      description: "The features of these crates are set for a reason (comments in Cargo.toml)",
      matchManagers: ["cargo"],
      matchPackageNames: ["flate2", "symphonia", "zip"],
      prBodyNotes: [
        "Keep the features that `Cargo.toml` sets for this crate. Its comments say why: the fixtures' gzip sizes assume flate2's miniz_oxide backend, and symphonia decodes only the codecs that the audio scan reads.",
      ],
    },
    {
      description: "release.yml is generated by cargo-dist, so a new cargo-dist needs dist generate",
      matchDepNames: ["cargo-dist"],
      automerge: false,
      prBodyNotes: [
        "`.github/workflows/release.yml` is generated. Run `mise install`, then `dist generate` and `dist plan`, and push the new `release.yml` to this branch before you merge. Renovate does not run `dist generate`: it would run a new binary next to the bot's token.",
      ],
    },

    // Files that Renovate regenerates in the same commit.
    {
      matchManagers: ["cargo"],
      postUpgradeTasks: {
        commands: ["bash .github/renovate/third-party-notices.sh"],
        fileFilters: ["THIRD_PARTY_NOTICES.md"],
        installTools: { rust: {} },
      },
    },

    {
      description: "Never: these versions are inputs to byte-exact fixture builds",
      matchFileNames: ["fixtures/**"],
      enabled: false,
    },
  ],
}
