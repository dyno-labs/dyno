// oxlint's default rules, with warnings as errors (`--deny-warnings` in mise.toml).
{
  "ignorePatterns": [
    // Built from probe.ts, which is linted.
    "crates/dyno-cdp/probe/probe.js",
    "crates/dyno-cdp/probe/probe.field.js",
