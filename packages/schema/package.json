{
  "name": "@dyno-labs/schema",
  "version": "0.1.0",
  "description": "TypeScript types and JSON Schema for the JSON that dyno writes: check results, compare results, the runner protocol and the probe events.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyno-labs/dyno.git",
    "directory": "packages/schema"
  },
  "files": [
    "json/*.json",
    "ts/*.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./ts/index.ts",
  "exports": {
    ".": {
      "types": "./ts/index.ts"
    },
    "./json/*": "./json/*"
  }
}
